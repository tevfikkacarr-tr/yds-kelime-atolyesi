ürüp savunmak"}],"id":"maintain","title":"SÜRDÜRMEK · Maintain","pos":"v"},{"steps":[{"w":["develop"],"note":"genel; geliştirmek ya da gelişmek"},{"w":["evolve"],"note":"zamanla aşamalı biçimde gelişmek (nesnesiz)"},{"w":["foster"],"note":"gelişmesine uygun ortam hazırlamak"},{"w":["cultivate","nurture"],"note":"özenle ve uzun süre besleyerek geliştirmek"},{"w":["thrive","flourish"],"note":"nesnesiz; güçlü biçimde gelişip serpilmek"}],"id":"develop","title":"GELİŞMEK · Develop","pos":"v"},{"steps":[{"w":["consider"],"note":"genel; düşünmek, göz önünde bulundurmak"},{"w":["regard"],"note":"-olarak görmek (regard as)"},{"w":["perceive"],"note":"algılamak; öznel olarak öyle görmek"},{"w":["contemplate"],"note":"uzun uzun, derinlemesine düşünmek"},{"w":["deem"],"note":"resmi; -olarak saymak, addetmek"}],"id":"consider","title":"DÜŞÜNMEK · Consider","pos":"v"},{"steps":[{"w":["describe"],"note":"nasıl olduğunu betimlemek"},{"w":["outline","summarise"],"note":"outline ana hatlarıyla; summarise kısaca özetlemek"},{"w":["clarify"],"note":"belirsizliği gidererek açıklığa kavuşturmak"},{"w":["interpret"],"note":"anlamını yorumlayarak açıklamak"},{"w":["elaborate"],"note":"ayrıntılarıyla genişletip açıklamak"},{"w":["account for"],"note":"bir olgunun nedenini açıklamak"}],"id":"explain","title":"AÇIKLAMAK · Explain","pos":"v"},{"steps":[{"w":["gain"],"note":"genel; kazanmak, edinmek"},{"w":["obtain"],"note":"resmi; elde etmek (veri, izin, belge)"},{"w":["acquire"],"note":"zamanla edinmek (beceri, bilgi, şirket)"},{"w":["derive"],"note":"bir kaynaktan çıkarmak (fayda, anlam, gelir)"},{"w":["secure"],"note":"çabayla güvenceye alarak elde etmek"},{"w":["attain"],"note":"uzun çabayla hedefe ulaşmak"}],"id":"obtain","title":"ELDE ETMEK · Obtain","pos":"v"},{"steps":[{"w":["provide"],"note":"genel; sağlamak, temin etmek"},{"w":["enable"],"note":"olanak sağlamak, mümkün kılmak"},{"w":["facilitate"],"note":"süreci kolaylaştırmak"},{"w":["allocate"],"note":"belirli amaç için kaynak tah